# The ending for all your app names. With "lab": http://pdf.lab, http://home.lab, ...
# The dns stack answers these, see README.
LAB_DOMAIN=lab

# The ThinkPad's Tailscale IP. Get it with: tailscale ip -4
TAILSCALE_IP=100.81.88.57

# Random string for SearXNG. Make one with: openssl rand -hex 32
SEARXNG_SECRET=change-me

# Where this repo lives. install.fish fills it in.
HOMELAB_DIR=/opt/homelab

# Who the web terminal logs in as. install.sh fills it in.
SERVER_USER=amarnath
