# The address everything lives under. Take the ThinkPad's Tailscale IP
# (run: tailscale ip -4), swap the dots for dashes, and add .sslip.io
# Example: Tailscale IP 100.101.102.103 -> 100-101-102-103.sslip.io
# Then pdf.100-101-102-103.sslip.io opens Stirling PDF, etc.
LAB_DOMAIN=100-101-102-103.sslip.io

# Random string for SearXNG. Make one with: openssl rand -hex 32
SEARXNG_SECRET=change-me
