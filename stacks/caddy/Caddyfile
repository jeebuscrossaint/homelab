# One block per app: http://<name>.{$LAB_DOMAIN} -> <container name>:<port inside container>
# After editing, restart the caddy stack in Dockge.
# Plain http is fine here because only your Tailscale devices can reach it.

http://{$LAB_DOMAIN}, http://home.{$LAB_DOMAIN} {
	reverse_proxy homepage:3000
}

http://dockge.{$LAB_DOMAIN} {
	reverse_proxy dockge:5001
}

http://status.{$LAB_DOMAIN} {
	reverse_proxy uptime-kuma:3001
}

http://pdf.{$LAB_DOMAIN} {
	reverse_proxy stirling-pdf:8080
}

http://convert.{$LAB_DOMAIN} {
	reverse_proxy transmute:3313
}

http://search.{$LAB_DOMAIN} {
	reverse_proxy searxng:8080
}

http://changes.{$LAB_DOMAIN} {
	reverse_proxy changedetection:5000
}
